    <!-- Open Food Facts lookup. Off by default; never automatic. -->
    <string name="off_lookup_title">Cercare su Open Food Facts?</string>
    <string name="off_lookup_offer">Cerca questo su Open Food Facts</string>
    <string name="off_lookup_explainer">Open Food Facts è un database di prodotti alimentari libero e aperto. Se attivi questa opzione, l\'app può interrogarlo su un codice a barre che questo telefono non riconosce.\n\nSolo il numero del codice a barre viene inviato a Open Food Facts, e solo quando tocchi il pulsante. La richiesta non include account, identificatori pubblicitari o dati del diario.\n\nPuoi disattivarla di nuovo nelle Impostazioni.</string>
    <string name="off_lookup_enable">Attiva</string>
    <string name="look_up_online">Cerca su Open Food Facts</string>
    <string name="off_lookup_nothing_found">Neanche Open Food Facts ha dati utilizzabili per questo codice a barre.</string>
    <string name="off_lookup_unavailable">Impossibile raggiungere Open Food Facts. Controlla la connessione oppure aggiungi l\'alimento manualmente.</string>
    <string name="off_lookup_running">Connessione a Open Food Facts…</string>
    <string name="settings_off_lookup">Cerca online i codici a barre sconosciuti</string>
    <string name="settings_off_lookup_summary">Interroga Open Food Facts su un codice a barre che questo telefono non riconosce. Invia solo il codice a barre, e solo quando tocchi il pulsante dopo una scansione senza risultato. Disattivato per impostazione predefinita.</string>
