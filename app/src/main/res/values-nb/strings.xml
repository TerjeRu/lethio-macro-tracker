    <string name="off_lookup_title">Slå opp i Open Food Facts?</string>
    <string name="off_lookup_offer">Slå opp dette i Open Food Facts</string>
    <string name="off_lookup_explainer">Open Food Facts er en fri og åpen database over matvarer. Hvis du slår på dette, kan appen spørre den om en strekkode denne telefonen ikke kjenner igjen.\n\nBare strekkodenummeret sendes til Open Food Facts, og bare når du trykker på knappen. Forespørselen inneholder ingen konto, annonse-ID eller dagbokdata. Strekkodeskannerens separate diagnostikktrafikk til Google styres ikke av denne innstillingen.\n\nDu kan slå det av igjen i Innstillinger.</string>
    <string name="off_lookup_enable">Slå på</string>
    <string name="look_up_online">Slå opp i Open Food Facts</string>
    <string name="off_lookup_nothing_found">Open Food Facts har heller ikke brukbare opplysninger om denne strekkoden.</string>
    <string name="off_lookup_unavailable">Fikk ikke kontakt med Open Food Facts. Sjekk tilkoblingen, eller legg til matvaren manuelt.</string>
    <string name="off_lookup_running">Kontakter Open Food Facts…</string>
    <string name="settings_off_lookup">Slå opp ukjente strekkoder på nett</string>
    <string name="settings_off_lookup_summary">Spør Open Food Facts om en strekkode denne telefonen ikke kjenner igjen. Sender bare strekkoden, og bare når du trykker på knappen etter en skanning uten treff. Av som standard.</string>

    <string name="add_product">Legg til produkt</string>
