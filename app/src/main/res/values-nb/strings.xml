    <string name="per_100g_header">Per 100 g</string>
    <string name="save_product">Lagre produkt</string>
    <string name="contribute_to_off">Send også til Open Food Facts</string>
    <string name="contribute_to_off_detail">Publiserer dette produktet i Open Food Facts, slik at andre også kan finne det. Sender strekkoden, navnet, merket og verdiene over via Lethio, sammen med en tilfeldig app-identifikator som brukes til å moderere bidrag. Dagboken din sendes ikke.</string>
    <string name="contribute_not_sent_title">Ikke lagt til i Open Food Facts</string>
    <string name="contribute_unconfirmed_title">Bidraget er ikke bekreftet</string>
    <string name="contribute_sent_title">Sendt til Open Food Facts</string>
    <string name="contribute_accepted">Takk — dette produktet ligger nå i den åpne databasen, for alle.</string>
    <string name="continue_to_log">Fortsett</string>
    <string name="contribute_refused">Dette produktet ble ikke godkjent som bidrag. Det er lagret på telefonen, og du kan bruke det som vanlig.</string>
    <string name="contribute_unavailable">Det var ikke mulig å bekrefte om Open Food Facts mottok dette produktet. Det er lagret på telefonen. Sjekk Open Food Facts før du prøver igjen.</string>
    <string name="settings_off_contribute">Bidra med nye produkter</string>
    <string name="settings_off_contribute_summary">Lar appen tilby å dele et produkt med Open Food Facts når det ikke finnes en brukbar oppføring for strekkoden. Du velger for hvert produkt med en avkrysningsboks som ikke er krysset av i utgangspunktet. Av som standard og uavhengig av nettsøk.</string>
