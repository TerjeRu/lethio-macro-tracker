    <string name="off_lookup_title">¿Buscar en Open Food Facts?</string>
    <string name="off_lookup_offer">Buscar esto en Open Food Facts</string>
    <string name="off_lookup_explainer">Open Food Facts es una base de datos de productos alimenticios libre y abierta. Si activas esto, la aplicación puede consultarle un código de barras que este teléfono no reconoce.\n\nSolo se envía el número del código de barras a Open Food Facts, y solo cuando pulsas el botón. Esa solicitud no incluye ninguna cuenta, identificador publicitario ni datos del diario. El tráfico de diagnóstico de Google independiente del escáner de códigos de barras no está controlado por este ajuste.\n\nPuedes desactivarlo de nuevo en Ajustes.</string>
    <string name="off_lookup_enable">Activar</string>
    <string name="look_up_online">Buscar en Open Food Facts</string>
    <string name="off_lookup_nothing_found">Open Food Facts tampoco tiene datos utilizables para este código de barras.</string>
    <string name="off_lookup_unavailable">No se pudo conectar con Open Food Facts. Comprueba tu conexión o añade el alimento manualmente.</string>
    <string name="off_lookup_running">Contactando con Open Food Facts…</string>
    <string name="settings_off_lookup">Buscar códigos de barras desconocidos en línea</string>
    <string name="settings_off_lookup_summary">Consultar a Open Food Facts un código de barras que este teléfono no reconoce. Envía solo el código de barras, y solo cuando pulsas el botón tras un escaneo sin resultado. Desactivado de forma predeterminada.</string>

