    <string name="per_100g_header">Por 100 g</string>
    <string name="save_product">Guardar producto</string>
    <string name="contribute_to_off">Enviar también a Open Food Facts</string>
    <string name="contribute_to_off_detail">Publica este producto en Open Food Facts para que otras personas también puedan encontrarlo. Envía mediante Lethio el código de barras, el nombre, la marca y los valores de arriba, además de un identificador aleatorio de la aplicación utilizado para moderar contribuciones. No envía tu diario.</string>
    <string name="contribute_not_sent_title">No añadido a Open Food Facts</string>
    <string name="contribute_unconfirmed_title">Contribución no confirmada</string>
    <string name="contribute_sent_title">Enviado a Open Food Facts</string>
    <string name="contribute_accepted">Gracias: este producto ya está en la base de datos abierta para todo el mundo.</string>
    <string name="continue_to_log">Continuar</string>
    <string name="contribute_refused">Este producto no fue aceptado como contribución. Está guardado en tu teléfono y puedes seguir usándolo con normalidad.</string>
    <string name="contribute_unavailable">No se pudo confirmar si Open Food Facts recibió este producto. Está guardado en tu teléfono. Comprueba Open Food Facts antes de intentarlo de nuevo.</string>
    <string name="settings_off_contribute">Contribuir productos nuevos</string>
    <string name="settings_off_contribute_summary">Permite que la aplicación ofrezca compartir un producto con Open Food Facts cuando no haya una entrada utilizable para ese código de barras. Tú decides sobre cada producto mediante una casilla que empieza desmarcada. Desactivado de forma predeterminada e independiente de la búsqueda en línea.</string>
