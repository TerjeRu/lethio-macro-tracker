<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- No cloud backup, including credential- and device-protected storage. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- An include list disables default inclusion of all other files. Keep the SQLite
         companions together with the diary; never transfer DataStore's install UUID or consent,
         the language mirror, or the replaceable nutrition catalogue. -->
    <device-transfer>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
        <include domain="database" path="user.db-shm" />
    </device-transfer>
</data-extraction-rules>
