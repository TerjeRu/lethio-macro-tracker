    <string name="off_lookup_title">Look up in Open Food Facts?</string>
    <string name="off_lookup_offer">Look this up in Open Food Facts</string>
    <string name="off_lookup_explainer">Open Food Facts is a free, open database of food products. If you turn this on, the app can ask it about a barcode this phone does not recognise.

Only the barcode number is sent to Open Food Facts, and only when you tap the button. That request includes no account, advertising identifier or diary data. The barcode scanner’s separate Google diagnostic traffic is not controlled by this setting.

You can turn this off again in Settings.</string>
    <string name="off_lookup_enable">Turn on</string>
    <string name="look_up_online">Look up in Open Food Facts</string>
    <string name="off_lookup_nothing_found">Open Food Facts does not have usable details for this barcode either.</string>
    <string name="off_lookup_unavailable">Could not reach Open Food Facts. Check your connection, or add the food manually.</string>
    <string name="off_lookup_running">Contacting Open Food Facts…</string>
    <string name="settings_off_lookup">Look up unknown barcodes online</string>
    <string name="settings_off_lookup_summary">Ask Open Food Facts about a barcode this phone does not recognise. Sends only the barcode, only when you tap the button on a failed scan. Off by default.</string>

