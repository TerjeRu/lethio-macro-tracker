    <!-- Open Food Facts lookup. Off by default; never automatic. -->
    <string name="off_lookup_title">Slå upp i Open Food Facts?</string>
    <string name="off_lookup_offer">Slå upp detta i Open Food Facts</string>
    <string name="off_lookup_explainer">Open Food Facts är en fri och öppen databas över livsmedel. Om du slår på detta kan appen fråga den om en streckkod som den här telefonen inte känner igen.\n\nEndast streckkodsnumret skickas till Open Food Facts, och bara när du trycker på knappen. Den begäran innehåller inget konto, annons-ID eller några dagboksdata.\n\nDu kan stänga av det igen i Inställningar.</string>
    <string name="off_lookup_enable">Slå på</string>
    <string name="look_up_online">Slå upp i Open Food Facts</string>
    <string name="off_lookup_nothing_found">Open Food Facts har inte heller användbara uppgifter om den här streckkoden.</string>
    <string name="off_lookup_unavailable">Kunde inte nå Open Food Facts. Kontrollera anslutningen eller lägg till livsmedlet manuellt.</string>
    <string name="off_lookup_running">Kontaktar Open Food Facts…</string>
    <string name="settings_off_lookup">Slå upp okända streckkoder online</string>
    <string name="settings_off_lookup_summary">Fråga Open Food Facts om en streckkod som den här telefonen inte känner igen. Skickar bara streckkoden, och bara när du trycker på knappen efter en skanning utan träff. Av som standard.</string>
    <!-- Lagga till en produkt och bidra med den (uppgift 067). Av som standard; aldrig automatiskt. -->
    <string name="add_product">Lägg till produkt</string>
    <string name="barcode_label">Streckkod: %1$s</string>
