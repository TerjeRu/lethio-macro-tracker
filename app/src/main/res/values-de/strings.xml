    <!-- Open Food Facts lookup. Off by default; never automatic. -->
    <string name="off_lookup_title">In Open Food Facts nachschlagen?</string>
    <string name="off_lookup_offer">Das in Open Food Facts nachschlagen</string>
    <string name="off_lookup_explainer">Open Food Facts ist eine kostenlose, offene Datenbank für Lebensmittel. Wenn du das einschaltest, kann die App dort nach einem Barcode fragen, den dieses Telefon nicht kennt.\n\nNur die Barcode-Nummer wird an Open Food Facts gesendet, und nur wenn du auf die Schaltfläche tippst. Diese Anfrage enthält weder ein Konto noch eine Werbe-ID oder Tagebuchdaten.\n\nDu kannst das in den Einstellungen wieder ausschalten.</string>
    <string name="off_lookup_enable">Einschalten</string>
    <string name="look_up_online">In Open Food Facts nachschlagen</string>
    <string name="off_lookup_nothing_found">Auch Open Food Facts hat keine brauchbaren Angaben zu diesem Barcode.</string>
    <string name="off_lookup_unavailable">Open Food Facts ist nicht erreichbar. Prüfe deine Verbindung, oder füge das Lebensmittel manuell hinzu.</string>
    <string name="off_lookup_running">Open Food Facts wird kontaktiert…</string>
    <string name="settings_off_lookup">Unbekannte Barcodes online nachschlagen</string>
    <string name="settings_off_lookup_summary">Open Food Facts nach einem Barcode fragen, den dieses Telefon nicht kennt. Sendet nur den Barcode, und nur wenn du bei einem erfolglosen Scan darauf tippst. Standardmäßig aus.</string>
    <!-- Adding a product, and contributing it to Open Food Facts. -->
    <string name="add_product">Produkt hinzufügen</string>
    <string name="barcode_label">Barcode: %1$s</string>
    <string name="brand_label">Marke (optional)</string>
    <string name="per_100g_header">Pro 100 g</string>
    <string name="save_product">Produkt speichern</string>
    <string name="contribute_to_off">Auch an Open Food Facts senden</string>
    <string name="contribute_to_off_detail">Veröffentlicht dieses Produkt bei Open Food Facts, damit andere es ebenfalls finden können. Sendet Barcode, Name, Marke und die Werte oben über Lethio sowie eine zufällige App-Kennung zur Moderation von Beiträgen. Dein Tagebuch wird nicht gesendet.</string>
    <string name="contribute_not_sent_title">Nicht zu Open Food Facts hinzugefügt</string>
    <string name="contribute_unconfirmed_title">Beitrag nicht bestätigt</string>
    <string name="contribute_sent_title">An Open Food Facts gesendet</string>
    <string name="contribute_accepted">Danke — dieses Produkt ist jetzt für alle in der offenen Datenbank.</string>
    <string name="continue_to_log">Weiter</string>
    <string name="contribute_refused">Dieses Produkt wurde nicht als Beitrag angenommen. Es ist auf deinem Telefon gespeichert und du kannst es wie gewohnt verwenden.</string>
    <string name="contribute_unavailable">Es konnte nicht bestätigt werden, ob Open Food Facts dieses Produkt erhalten hat. Es ist auf deinem Telefon gespeichert. Prüfe Open Food Facts, bevor du es erneut versuchst.</string>
    <string name="settings_off_contribute">Neue Produkte beitragen</string>
    <string name="settings_off_contribute_summary">Die App kann dir anbieten, ein Produkt mit Open Food Facts zu teilen, wenn dort kein verwendbarer Eintrag für diesen Barcode vorhanden ist. Du entscheidest bei jedem Produkt über ein Kontrollkästchen, das zunächst nicht ausgewählt ist. Standardmäßig deaktiviert und unabhängig von der Online-Suche.</string>
